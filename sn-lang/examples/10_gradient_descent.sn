# Numerical gradients and optimisation
fn f(x) { return (x - 3) ** 2 + 1 }
print("slope of f at x=5:", round(grad(f, 5), 4))
print("minimum found by gradient descent:", round(gradient_descent(f, 0.0, lr=0.1, steps=200), 4))

# works on tensors too: minimise a bowl in 2-D
fn bowl(p) { return (p[0] - 1) ** 2 + (p[1] + 2) ** 2 }
print("minimum of bowl:", gradient_descent(bowl, tensor([5.0, 5.0]), lr=0.1, steps=300))

# fit a line y = w*x by hand using grad()
let xs = tensor([1, 2, 3, 4])
let ys = tensor([2.1, 3.9, 6.2, 7.8])
fn loss(w) { return ((xs * w - ys) ** 2).mean() }
let w = gradient_descent(loss, 0.0, lr=0.05, steps=200)
print(f"learned slope: {w:.3f}")
