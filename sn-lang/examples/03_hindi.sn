# पूरा प्रोग्राम हिंदी कीवर्ड के साथ
कार्य जोड़ो(क, ख) {
    लौटाओ क + ख
}

कार्य अभाज्य_है(संख्या) {
    अगर संख्या < 2 { लौटाओ झूठ }
    हर भाजक में श्रेणी(2, संख्या) {
        अगर भाजक * भाजक > संख्या { रोको }
        अगर संख्या % भाजक == 0 { लौटाओ झूठ }
    }
    लौटाओ सच
}

छापो("जोड़:", जोड़ो(3, 4))

मान अभाज्य = []
हर n में श्रेणी(2, 40) {
    अगर अभाज्य_है(n) { अभाज्य.push(n) }
}
छापो("40 से छोटी अभाज्य संख्याएँ:", अभाज्य)

मान अंक = [72, 85, 90, 66, 58]
छापो("औसत अंक:", औसत(अंक), " अधिकतम:", अधिकतम(अंक))

कोशिश {
    छापो(10 / 0)
} पकड़ो गलती {
    छापो("गलती पकड़ी गई:", गलती)
}
