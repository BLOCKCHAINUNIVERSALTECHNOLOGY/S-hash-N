# Find groups in unlabelled data with k-means
let iris = read_csv("examples/data/iris.csv")
let X = iris.select("petal_length", "petal_width").to_tensor()

let km = KMeans(k=3, seed=5)
let labels = km.fit_predict(X)
print("cluster centres (petal length, petal width):")
print(km.centroids)
print("inertia:", round(km.inertia, 2))

# how well do the clusters match the real species?
let species = iris["species"]
for c in range(3) {
    let members = [species[i] for i in range(len(labels)) if labels[i] == c]
    print(f"cluster {c}: {len(members)} flowers, mostly {mode(members)}")
}
