# Pattern matching with match / मिलान

fn describe(x) {
    return match x {
        0 => "zero"
        1 or 2 or 3 => "a few"
        n if type(n) == "int" and n < 0 => "negative"
        n if type(n) == "int" => f"{n} is big"
        "hi" or "hello" => "a greeting"
        nil => "nothing"
        [] => "an empty list"
        [only] => f"a list with just {only}"
        [first, ...rest] => f"starts with {first}, then {len(rest)} more"
        {kind: "circle", r} => f"circle of area {round(PI * r ** 2, 2)}"
        {kind: "rect", w, h} => f"rectangle of area {w * h}"
        _ => "something else"
    }
}

for v in [0, 2, -7, 42, "hello", nil, [], [9], [1, 2, 3],
          {kind: "circle", r: 2}, {kind: "rect", w: 3, h: 4}, 3.5] {
    print(f"{str(v):<42} -> {describe(v)}")
}

# arms can be blocks; the last expression is the value
let result = match [3, 4] {
    [a, b] => {
        let c = sqrt(a * a + b * b)
        f"hypotenuse {c}"
    }
    _ => "not a pair"
}
print(result)

# Hindi keyword
let मौसम = "बारिश"
print(मिलान मौसम {
    "धूप" => "छाता नहीं चाहिए"
    "बारिश" => "छाता ले जाओ"
    _ => "पता नहीं"
})
